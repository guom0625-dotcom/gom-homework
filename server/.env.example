PORT=3100
HOST=0.0.0.0
DB_PATH=./data/gom_homework.sqlite3
LOG_LEVEL=info

# ADMIN_SECRET: server-admin CLI auth (set a strong random string)
ADMIN_SECRET=changeme

# FCM_CREDENTIALS: Firebase 서비스 계정 키(JSON) 경로 — 푸시 알림 발송용 (없으면 알림 없이 동작)
# FCM_CREDENTIALS=./fcm-credentials.json

# REGISTER_DEADLINE_ENABLED: true 면 매니저가 '할일 등록 마감' 시각도 설정할 수 있다 (기본 꺼짐)
# REGISTER_DEADLINE_ENABLED=true
